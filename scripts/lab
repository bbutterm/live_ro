#!/usr/bin/env bash
# Управление лабораторией live_ro. Подробности: docs/SETUP.md, docs/RELEASES.md.
#
# Два режима (определяются env-файлом):
#   existing — уже собранный и работающий runtime оператора (задан RATHENA_DIR).
#              deploy/activate/db-init запрещены, conf/import rAthena
#              не перезаписывается (RENDER_SERVER_CONF=0 по умолчанию).
#   release  — версии собираются в $LAB_ROOT/releases/<sha12>, current/previous.
#
# Раскладка $LAB_ROOT (по умолчанию /opt/ro-bot-lab), создаётся без перезаписи:
#   secrets/live_ro.env  локальные секреты (600), вне Git
#   releases/<sha12>/    собранные версии (режим release)
#   current, previous    symlink на активную и предыдущую версию
#   run/                 pid-файлы и runtime-конфиги ботов (пересоздаются)
#   state/ logs/ backups/
# Ни одна команда не делает миграций БД и не перезапускает процессы сама.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAB_ROOT="${LAB_ROOT:-/opt/ro-bot-lab}"
LAB_ENV="${LAB_ENV:-$LAB_ROOT/secrets/live_ro.env}"
PIDS="$LAB_ROOT/run/pids"
SERVERS=(login char map)
declare -A PORT=([login]=6900 [char]=6121 [map]=5121)

die()  { printf 'lab: ОШИБКА: %s\n' "$*" >&2; exit 1; }
info() { printf 'lab: %s\n' "$*"; }
warn() { printf 'lab: ВНИМАНИЕ: %s\n' "$*" >&2; }

usage() {
  cat <<'EOF'
Использование: scripts/lab <команда> [аргументы]
Переменные: LAB_ROOT (/opt/ro-bot-lab), LAB_ENV ($LAB_ROOT/secrets/live_ro.env)

Одна команда для жизни:
  up                    запустить мозги, ботов и сторожа (поднимает упавших каждые 30 с)
  down                  остановить сторожа, ботов и мозги (серверы не трогает)
  report                сводка по каждому боту: где, чем занят, итоги суток, расходы, ресурсы
  resources             RSS/CPU тел и мозгов по /proc, SQLite и журналы, сколько ещё жителей влезет (ORG-047)
Только чтение:
  doctor                проверка окружения, конфигов, БД (только SELECT), процессов
  status                процессы, порты, режим и активная версия
  check                 статическая проверка репозитория
  releases              список версий (режим release)
Изменяющие:
  prepare               создать недостающие каталоги и env-файл (ничего не перезаписывает)
  start server|BOT|brain [BOT|all]|live [BOT|all]   серверы, бот, мозг, мозг+бот
  stop  server|BOT|brain [BOT|all]|live [BOT|all]|all [--force]   (по умолчанию all)
  brain-check [BOT]     один платный запрос к основной модели (только при BRAIN_LLM=openrouter)
  brain-check-jev [BOT] один запрос к JEV (только при BRAIN_GATE=jev)
  db-add-account BOT    создать игровой аккаунт BOT_USER/PASS (нужен бэкап за последние 24 ч)
  plan BOT meet ИМЯ     поручить мозгу BOT предложить встречу жителю ИМЯ (исполняет план мозг)
  plan BOT cancel       отменить активный план BOT
  plan BOT show         последние планы BOT из памяти (только чтение)
  routine BOT rest|hunt досрочно отправить BOT отдыхать в город / на охоту (проверка распорядка)
  routine BOT show      распорядок BOT из памяти (только чтение)
  chronicle [ДАТА]      хроника мира за сутки: события всех жителей вместе (только чтение памяти)
  dashboard [ДАТА]      HTML-дашборд мира: run/dashboard.html в LAB_ROOT, печатает путь (только чтение памяти)
  episode [НЕДЕЛЯ] [--llm]  серия недели мира: заголовок, 3–5 сцен по фактам, «в следующей серии»
                        (НЕДЕЛЯ — 2026-W40 или дата; --llm — окраска одним вызовом, если BRAIN_LLM включён)
  memoir BOT [НЕДЕЛЯ] [--llm]  мемуары жителя от первого лица по фактам памяти (вся жизнь или одна неделя;
                        --llm — окраска глав, если BRAIN_LLM включён; только чтение памяти)
  modules [BOT] [--disable СПИСОК]  какие модули мозга BOT создадутся при старте: BRAIN_DISABLE из env (или
                        СПИСОК — примерка этапа), goals.json, нужные модули/жители; опечатки в BRAIN_DISABLE
                        (только чтение, docs/ROLLOUT.md)
  alerts [N]            последние оповещения владельцу (тупик, восстановление невозможно, сторож сдался)
  organic [BOT|all] [--days N] [--json] [--alerts]   метрики органичности M1–M22 «мёртво/живо/шумно» по жителю и
                        миру, «кто вёл тело»; --alerts — «шумно/мертво» 2 дня подряд в run/alerts.log (ORG-113/114;
                        только чтение памяти, шины и decisions.jsonl; docs/ROLLOUT.md)
  gift BOT ITEM N       BOT сейчас просит у жителя рядом N предметов ITEM (ID, например 501, или z — зени);
                        для проверки обмена: оба в городе (routine BOT rest), правила отдающего действуют
Боты: LAB_BOTS в env-файле (по умолчанию "bot01"). LAB_MAX_ONLINE=N — сторож и up держат онлайн не больше N
                        бодрствующих жителей (ORG-044, сон по brain/personas/*.json); пусто — все из LAB_BOTS.
                        Сверх лимита сторож просит мозг уснуть раньше; уснувший освобождает процесс тела.
  db-backup             дамп основной и лог-БД в backups/
Население (ORG-040..043, docs/POPULATION.md):
  roster [check]        реестр жителей brain/world/roster.json против профилей и персон (только чтение)
  roster sync [--write] residents/dealAuto_names в bots/*/control/config.txt по реестру (меняет checkout)
  new-resident BOT ШАБЛОН ИМЯ [--sex M|F] [--persona FILE]
                        новый житель из bots/templates/ШАБЛОН (active: false): профиль, персона, реестр
  birth BOT [--yes]     процедура рождения: проверки и следующие шаги; с --yes — db-backup (если нет
                        свежего) и db-add-account BOT, больше ничего
  census [--json]       перепись мира и «кого родить следующим»: роли, связи, дефицит, ресурсы, блокеры
                        рождения (ORG-088; только чтение, только совет)
Только режим release:
  build [DIR] | deploy <commit> | activate <release> | rollback | db-init
EOF
}

# ---------- окружение ----------

guard_user() {
  [[ $(id -u) != 0 ]] || die "не запускайте от root: runtime-файлы должны принадлежать пользователю лаборатории (sudo -u ro-lab ...)"
  if [[ -d "$LAB_ROOT" ]]; then
    local owner; owner=$(stat -c %U "$LAB_ROOT")
    [[ "$owner" == "$(id -un)" ]] || die "$LAB_ROOT принадлежит $owner; запускайте от него: sudo -u $owner scripts/lab ..."
  fi
}

load_env() {
  [[ -f "$LAB_ENV" ]] || die "нет $LAB_ENV; выполните: scripts/lab prepare"
  local mode; mode=$(stat -c %a "$LAB_ENV")
  [[ "$mode" == 600 || "$mode" == 400 ]] || die "$LAB_ENV должен иметь права 600 (сейчас $mode)"
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^[[:space:]]*(#|$) ]] && continue
    [[ "$line" == *=* ]] || die "$LAB_ENV: строка без '=': $line"
    key="${line%%=*}"; val="${line#*=}"
    key="${key//[[:space:]]/}"
    [[ "$key" =~ ^[A-Z][A-Z0-9_]*$ ]] || die "$LAB_ENV: неверное имя $key"
    [[ "$key" == LAB_ROOT || "$key" == LAB_ENV ]] && continue
    printf -v "$key" '%s' "$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<<"$val")"
  done < "$LAB_ENV"
}

is_set() { [[ -n "${!1:-}" && "${!1}" != CHANGE_ME ]]; }

need_var() {
  local v
  for v in "$@"; do is_set "$v" || die "заполните $v в $LAB_ENV"; done
}

# Логины/пароли rAthena: буфер 24 байта -> не длиннее 23 ASCII-символов.
# Локаль C: иначе в UTF-8 локалях диапазоны и классы в regex bash ведут себя иначе
# (Hermes: в его локали ^[!-~]{1,23}$ не совпадал даже с "bot01").
cred_ok() {
  local LC_ALL=C val="${!1:-}"
  [[ "$val" =~ ^[[:graph:]]{1,23}$ ]]
}
check_cred() {
  local val="${!1:-}"
  cred_ok "$1" || die "$1: нужно 1-23 печатных ASCII-символа без пробелов (сейчас длина ${#val})"
}

existing_mode() { [[ -n "${RATHENA_DIR:-}" ]]; }

require_release_mode() {
  if existing_mode; then
    die "команда '$1' отключена в режиме existing (задан RATHENA_DIR): рабочий стек и БД не пересоздаются"
  fi
}

current_release() {
  [[ -L "$LAB_ROOT/current" ]] || die "нет активной версии; выполните deploy и activate (или задайте RATHENA_DIR для режима existing)"
  readlink -f "$LAB_ROOT/current"
}

rathena_dir() {
  if existing_mode; then readlink -f "$RATHENA_DIR"; else echo "$(current_release)/upstream/rathena"; fi
}
openkore_dir() {
  if [[ -n "${OPENKORE_DIR:-}" ]]; then readlink -f "$OPENKORE_DIR"
  else echo "$(current_release)/upstream/openkore"; fi
}
# Откуда брать профили ботов, плагины и шаблоны: в existing — из этого checkout.
profile_root() { if existing_mode; then echo "$REPO"; else current_release; fi; }

render_server_conf() {
  local def=1; existing_mode && def=0
  [[ "${RENDER_SERVER_CONF:-$def}" == 1 ]]
}

build_conf() { # читает server/build.conf из каталога $1
  local f="$1/server/build.conf"
  [[ -f "$f" ]] || die "нет $f"
  PACKETVER=$(sed -n 's/^PACKETVER=//p' "$f")
  RATHENA_CONFIGURE_FLAGS=$(sed -n 's/^RATHENA_CONFIGURE_FLAGS=//p' "$f")
  RATHENA_TARGETS=$(sed -n 's/^RATHENA_TARGETS=//p' "$f")
  [[ "$PACKETVER" =~ ^[0-9]{8}$ ]] || die "$f: неверный PACKETVER"
}

# ---------- БД ----------

conf_value() { # conf_value FILE KEY -> последнее значение ключа rAthena
  sed -n "s/^[[:space:]]*$2:[[:space:]]*//p" "$1" 2>/dev/null | sed 's/[[:space:]]*$//' | tail -n1
}

# Реквизиты БД: из env-файла, а если DB_PASS там не задан и conf/import не
# рендерится — из уже существующего conf/import/inter_conf.txt рабочего rAthena.
resolve_db() {
  if is_set DB_PASS; then
    need_var DB_HOST DB_PORT DB_NAME DB_USER
    LOG_DB_NAME="${LOG_DB_NAME:-$DB_NAME}"
    DB_SOURCE="$LAB_ENV"
    return
  fi
  render_server_conf && die "заполните DB_* в $LAB_ENV"
  local f; f="$(rathena_dir)/conf/import/inter_conf.txt"
  [[ -r "$f" ]] || die "DB_PASS не задан, и нет доступа к $f"
  DB_HOST=$(conf_value "$f" char_server_ip); DB_PORT=$(conf_value "$f" char_server_port)
  DB_USER=$(conf_value "$f" char_server_id); DB_PASS=$(conf_value "$f" char_server_pw)
  DB_NAME=$(conf_value "$f" char_server_db); LOG_DB_NAME=$(conf_value "$f" log_db_db)
  DB_HOST=${DB_HOST:-127.0.0.1}; DB_PORT=${DB_PORT:-3306}; LOG_DB_NAME=${LOG_DB_NAME:-$DB_NAME}
  [[ -n "$DB_USER" && -n "$DB_PASS" && -n "$DB_NAME" ]] || die "в $f нет char_server_id/pw/db"
  DB_SOURCE="$f"
}

mysql_bin() { command -v mariadb || command -v mysql || die "нет клиента mariadb/mysql"; }

mycnf() { printf '[client]\nhost=%s\nport=%s\nuser=%s\npassword=%s\n' "$DB_HOST" "$DB_PORT" "$DB_USER" "$DB_PASS"; }

# sql DBNAME args... — пароль передаётся через /dev/fd: не в argv и не на диск.
sql() { local db="$1"; shift; "$(mysql_bin)" --defaults-extra-file=<(mycnf) "$db" "$@"; }

sql_quote() { local s=${1//\\/\\\\}; s=${s//\'/\\\'}; printf "'%s'" "$s"; }

# bot_online BOT -> "1"/"0" (персонаж аккаунта бота в мире по char.online) или пусто,
# если БД недоступна. Только SELECT: флаг выставляет сам rAthena.
bot_online() {
  local u="${1^^}_USER"
  is_set "$u" || return 0
  ( resolve_db ) >/dev/null 2>&1 || return 0
  resolve_db
  sql "$DB_NAME" -N -e "SELECT COALESCE(MAX(c.online),0) FROM \`char\` c JOIN login l USING (account_id) WHERE l.userid=$(sql_quote "${!u}")" 2>/dev/null || true
}

# wait_offline BOT MAX_SEC -> ждёт char.online=0, печатает время; 1 если не дождался.
wait_offline() {
  local bot="$1" max="$2" i st
  st=$(bot_online "$bot")
  if [[ -z "$st" ]]; then info "$bot: состояние на сервере неизвестно (БД недоступна)"; return 0; fi
  for ((i = 0; i <= max; i += 2)); do
    st=$(bot_online "$bot")
    if [[ "$st" == 0 ]]; then
      info "$bot: сервер снял персонажа с карты (char.online=0) через ${i} с после проверки"
      return 0
    fi
    sleep 2
  done
  warn "$bot: персонаж всё ещё online на сервере через ${max} с"
  return 1
}

log_mark() { # отметка сегмента в консольном логе бота
  printf '=== live_ro %s %s %s commit %s ===\n' "$2" "$1" "$(date -u +%FT%TZ)" \
    "$(git -C "$(profile_root)" rev-parse --short=12 HEAD 2>/dev/null || echo '?')" \
    >> "$LAB_ROOT/logs/$1/console.log"
}

# ---------- процессы ----------

proc_cwd()  { readlink "/proc/$1/cwd" 2>/dev/null || true; }
proc_args() { { tr '\0' ' ' < "/proc/$1/cmdline"; } 2>/dev/null || true; }
proc_user() { stat -c %U "/proc/$1" 2>/dev/null || echo '?'; }

# find_procs NAME -> строки "pid owner [пометка]": процессы сервера/бота
# лаборатории, включая запущенные не этим скриптом (без pid-файла).
find_procs() {
  local name="$1" p args argv0 cwd want_dir
  case "$name" in
    login|char|map) want_dir=$(rathena_dir 2>/dev/null || true) ;;
    *)              want_dir="" ;;
  esac
  local -a okore=()
  for p in /proc/[0-9]*; do
    p=${p#/proc/}
    [[ "$p" == "$$" || "$p" == "$BASHPID" ]] && continue
    args=$(proc_args "$p"); [[ -n "$args" ]] || continue
    argv0=${args%% *}
    case "$name" in
      login|char|map)
        [[ "$(basename -- "$argv0")" == "$name-server" ]] || continue
        cwd=$(proc_cwd "$p")
        # cwd чужого процесса недоступен: тогда для отчёта достаточно совпадения имени.
        [[ -z "$cwd" || -z "$want_dir" || "$cwd" == "$want_dir" ]] || continue
        echo "$p $(proc_user "$p")" ;;
      supervisor)
        [[ "$args" == *"/scripts/lab supervise"* ]] || continue
        echo "$p $(proc_user "$p")" ;;
      brain-*)
        [[ "$(basename -- "$argv0")" == python* && "$args" == *"-m live_brain"* \
           && "$args" == *"--bot ${name#brain-} "* && "$args" == *"--lab-root $LAB_ROOT "* ]] || continue
        echo "$p $(proc_user "$p")" ;;
      *)
        [[ "$(basename -- "$argv0")" == perl* && "$args" == *openkore.pl* ]] || continue
        if [[ "$args" == *"/$name/"* || "$args" == *"/$name "* ]]; then
          echo "$p $(proc_user "$p")"
        elif [[ "$args" =~ /bot[0-9]+(/|[[:space:]]) ]]; then
          # Another explicitly labelled bot is not an unlabelled bot01.
          continue
        else
          okore+=("$p")
        fi ;;
    esac
  done
  # Профиль не виден в аргументах (ручной запуск): единственный OpenKore считаем bot01.
  if [[ "$name" == bot01 && ${#okore[@]} == 1 ]]; then
    echo "${okore[0]} $(proc_user "${okore[0]}") без-метки-профиля"
  fi
}

# Первая строка find_procs без конвейера: с pipefail `find_procs | head -n1`
# падает по SIGPIPE, когда процессов больше одного, и set -e молча завершает скрипт.
first_proc() {
  local out; out=$(find_procs "$1")
  printf '%s\n' "${out%%$'\n'*}"
}

running_pid() { # первый найденный pid или пусто
  local line; line=$(first_proc "$1"); echo "${line%% *}"
}

port_open() { (exec 3<>"/dev/tcp/${BIND_IP:-127.0.0.1}/$1") 2>/dev/null; }

rotate_log() { # одна предыдущая копия, если лог больше LOG_MAX_MB
  local f="$1" max=$(( ${LOG_MAX_MB:-50} * 1024 * 1024 ))
  if [[ -f "$f" ]] && (( $(stat -c %s "$f") > max )); then mv -f "$f" "$f.1"; fi
}

lab_bots() { # список ботов лаборатории
  local b
  for b in ${LAB_BOTS:-bot01}; do
    [[ "$b" =~ ^bot[0-9]+$ ]] || die "LAB_BOTS: неверное имя '$b' (ожидается botNN)"
    echo "$b"
  done
}

bots_arg() { # bots_arg [BOT|all] -> список ботов
  if [[ -z "${1:-}" || "$1" == all ]]; then lab_bots
  elif [[ "$1" =~ ^bot[0-9]+$ ]]; then echo "$1"
  else die "ожидается botNN или all, получено '$1'"; fi
}

stack_running() {
  local n
  for n in "${SERVERS[@]}" $(lab_bots); do [[ -n "$(running_pid "$n")" ]] && return 0; done
  return 1
}

# ---------- prepare / check / doctor ----------

cmd_prepare() {
  local missing=() c
  for c in git python3 perl; do command -v "$c" >/dev/null || missing+=("$c"); done
  command -v mariadb >/dev/null || command -v mysql >/dev/null || missing+=("mariadb-client")
  if ((${#missing[@]})); then warn "не хватает: ${missing[*]}"; fi
  ( umask 077; mkdir -p "$LAB_ROOT"/{secrets,run/pids,state,backups} )
  mkdir -p "$LAB_ROOT"/logs/rathena
  if [[ -e "$LAB_ENV" ]]; then
    info "$LAB_ENV уже существует — не трогаю"
  else
    install -m 600 "$REPO/live_ro.env.example" "$LAB_ENV"
    info "создан $LAB_ENV — заполните его (см. docs/SETUP.md)"
  fi
  info "каталоги проверены в $LAB_ROOT (существующие файлы не изменялись)"
}

cmd_check() { python3 "$REPO/scripts/check.py" "${1:-$REPO}"; }

DOC_FAIL=0
ok()   { printf '  [OK]   %s\n' "$*"; }
bad()  { printf '  [FAIL] %s\n' "$*"; DOC_FAIL=1; }
note() { printf '  [INFO] %s\n' "$*"; }

cmd_doctor() {
  echo "== окружение"
  note "пользователь $(id -un), LAB_ROOT=$LAB_ROOT, checkout $(git -C "$REPO" rev-parse --short=12 HEAD)"
  if [[ -z "$(git -C "$REPO" status --porcelain --ignore-submodules=none)" ]]; then
    ok "checkout чистый"
  else
    bad "checkout грязный (git status)"
  fi
  load_env; ok "$LAB_ENV читается, права $(stat -c %a "$LAB_ENV")"
  if existing_mode; then note "режим existing: RATHENA_DIR=$(rathena_dir)"; else note "режим release"; fi
  if render_server_conf; then
    note "conf/import rAthena рендерится из шаблонов при start"
  else
    note "conf/import rAthena НЕ перезаписывается (RENDER_SERVER_CONF=0)"
  fi
  local v
  local bu=()
  for v in $(lab_bots); do bu+=("${v^^}_USER" "${v^^}_PASS"); done
  for v in INTER_USER INTER_PASS "${bu[@]}"; do
    is_set "$v" || continue
    if cred_ok "$v"; then ok "$v: формат допустим"; else bad "$v: нужно 1-23 ASCII без пробелов"; fi
  done

  echo "== rAthena"
  local rd s f; rd=$(rathena_dir)
  for s in "${SERVERS[@]}"; do
    if [[ -x "$rd/$s-server" ]]; then ok "$s-server"; else bad "нет $rd/$s-server"; fi
  done
  for f in inter_conf char_conf map_conf login_conf; do
    if [[ -r "$rd/conf/import/$f.txt" ]]; then ok "conf/import/$f.txt читается"
    elif render_server_conf; then note "conf/import/$f.txt будет создан при start"
    else bad "нет доступа к conf/import/$f.txt"; fi
  done

  echo "== карты мира (AUT-031)"
  if python3 "$REPO/scripts/world_maps.py" "$rd" "$(profile_root)" $(lab_bots); then
    ok "все карты жителей включены в rAthena"
  else
    bad "жителям нужны выключенные карты (выше) — включить в rAthena или поменять профиль/goals.json"
  fi
  echo "== OpenKore"
  local od pr; od=$(openkore_dir); pr=$(profile_root)
  if [[ -f "$od/openkore.pl" ]]; then ok "openkore.pl в $od"; else bad "нет $od/openkore.pl"; fi
  if [[ -e "$od/src/auto/XSTools/XSTools.so" ]]; then ok "XSTools.so собран"; else bad "нет XSTools.so"; fi
  local b p
  for b in $(lab_bots); do
    if [[ -f "$pr/bots/$b/control/config.txt" ]]; then ok "профиль $b из $pr"; else bad "нет профиля bots/$b"; fi
    if [[ -f "$pr/brain/personas/$b.json" ]]; then ok "характер brain/personas/$b.json"; else note "нет характера $b.json (мозг для $b не запустится)"; fi
    v="${b^^}_CONTROL_DIR"
    if is_set "$v"; then note "$b использует готовый control: ${!v} (профиль и плагины из Git НЕ применяются)"; fi
  done
  for p in lowHpGuard gracefulStop brainBridge combatProfile economy survival jobChange autoCreate pets refine spar; do  # refine: spar:
    if [[ -f "$pr/bots/plugins/$p/$p.pl" ]]; then ok "плагин $p"; else bad "нет плагина $p"; fi
  done
  echo "== жители (реестр ORG-040)"
  python3 "$pr/scripts/lib/roster.py" --repo "$pr" check --bots "$(lab_bots | tr '\n' ' ')" || DOC_FAIL=1
  for b in $(lab_bots); do
    if [[ -f "$LAB_ROOT/logs/$b/autoCreate.refused" ]]; then
      bad "$b: сервер отказал в создании персонажа ($(tr '\n' ' ' < "$LAB_ROOT/logs/$b/autoCreate.refused")) — разобраться и удалить метку"
    fi
  done
  if [[ -n "${LAB_MAX_ONLINE:-}" ]]; then
    note "LAB_MAX_ONLINE=$LAB_MAX_ONLINE: сейчас онлайн держатся $(shift_bots | tr '\n' ' ')(ORG-044)"
  fi
  echo "== мозг"
  if command -v python3 >/dev/null; then ok "python3 $(python3 -c 'import sys;print("%d.%d"%sys.version_info[:2])')"; else bad "нет python3"; fi
  if [[ "${BRAIN_LLM:-off}" == openrouter ]]; then
    if is_set OPENROUTER_API_KEY; then ok "BRAIN_LLM=openrouter, модель ${OPENROUTER_MODEL:-deepseek/deepseek-chat}, лимит ${BRAIN_DAILY_LIMIT:-300}/сутки на бота"
    else bad "BRAIN_LLM=openrouter, но OPENROUTER_API_KEY пуст"; fi
  else note "BRAIN_LLM=off: платные вызовы выключены"; fi
  if [[ "${BRAIN_GATE:-rules}" == jev ]]; then
    if is_set JEV_API_KEY && is_set JEV_API_BASE && is_set JEV_MODEL; then ok "JEV: $JEV_MODEL @ $JEV_API_BASE, лимит ${JEV_DAILY_LIMIT:-2000}/сутки на бота"
    else bad "BRAIN_GATE=jev, но JEV_API_BASE/JEV_API_KEY/JEV_MODEL не заполнены"; fi
  else note "BRAIN_GATE=rules: JEV не используется"; fi

  echo "== БД (только SELECT)"
  if ( resolve_db ) 2>/dev/null; then
    resolve_db
    note "реквизиты из $DB_SOURCE"
    if sql "$DB_NAME" -N -e 'SELECT 1' >/dev/null 2>&1; then
      ok "подключение к $DB_NAME"
      # shellcheck disable=SC2016
      note "аккаунтов: $(sql "$DB_NAME" -N -e 'SELECT COUNT(*) FROM login'), персонажей: $(sql "$DB_NAME" -N -e 'SELECT COUNT(*) FROM `char`')"
      for b in $(lab_bots); do
        v="${b^^}_USER"
        is_set "$v" || { note "$b: ${v} не задан"; continue; }
        local found
        found=$(sql "$DB_NAME" -N -e "SELECT CONCAT(c.name, ' slot ', c.char_num, ' lv ', c.base_level, ' map ', c.last_map, ' online ', c.online) FROM \`char\` c JOIN login l USING (account_id) WHERE l.userid=$(sql_quote "${!v}")" 2>/dev/null || true)
        if [[ -n "$found" ]]; then note "$b: $found"
        elif [[ -n "$(sql "$DB_NAME" -N -e "SELECT account_id FROM login WHERE userid=$(sql_quote "${!v}")" 2>/dev/null)" ]]; then
          note "$b: аккаунт есть, персонажа нет (autoCreate 1 создаст при start, иначе — консоль OpenKore в tmux)"
        else note "$b: аккаунта нет (scripts/lab db-add-account $b после db-backup)"; fi
      done
    else
      bad "нет подключения к $DB_NAME"
    fi
    if sql "$LOG_DB_NAME" -N -e 'SELECT 1' >/dev/null 2>&1; then ok "подключение к $LOG_DB_NAME"; else bad "нет подключения к $LOG_DB_NAME"; fi
  else
    bad "реквизиты БД не определены"
  fi

  echo "== процессы"
  cmd_status_body
  if ((DOC_FAIL == 0)); then info "doctor: ошибок нет"; else info "doctor: есть ошибки [FAIL]"; return 1; fi
}

# ---------- сборка и релизы (режим release) ----------

cmd_build() {
  local dir; dir=$(cd "${1:-$REPO}" && pwd)
  build_conf "$dir"
  local jobs="${MAKE_JOBS:-1}"
  info "rAthena: PACKETVER=$PACKETVER $RATHENA_CONFIGURE_FLAGS, make -j$jobs $RATHENA_TARGETS"
  ( cd "$dir/upstream/rathena"
    # shellcheck disable=SC2086
    ./configure --enable-packetver="$PACKETVER" $RATHENA_CONFIGURE_FLAGS
    # shellcheck disable=SC2086
    make -j"$jobs" $RATHENA_TARGETS )
  local b
  for b in "${SERVERS[@]}"; do
    [[ -x "$dir/upstream/rathena/$b-server" ]] || die "не собран $b-server"
  done
  info "OpenKore: XSTools"
  # upstream Makefile вызывает `python` и скрывает ошибку — вызываем scons напрямую.
  ( cd "$dir/upstream/openkore" && python3 src/scons-local-3.1.2/scons.py )
  [[ -e "$dir/upstream/openkore/src/auto/XSTools/XSTools.so" ]] || die "не собран XSTools.so"
  info "BUILD_OK $dir (runtime не проверен)"
}

require_clean() { # чистый checkout, включая содержимое submodules
  local dirty
  dirty=$(git -C "$1" status --porcelain --ignore-submodules=none)
  [[ -z "$dirty" ]] || die "грязный checkout $1 — закоммитьте или уберите изменения:
$dirty"
}

apply_patches() { # apply_patches RELEASE_DIR
  local rel="$1" sub p
  for sub in rathena openkore; do
    for p in "$rel/server/patches/$sub"/*.patch; do
      [[ -e "$p" ]] || continue
      info "патч $sub/$(basename "$p")"
      git -C "$rel/upstream/$sub" apply --check "$p" || die "патч не накладывается: $p"
      git -C "$rel/upstream/$sub" apply "$p"
    done
  done
}

cmd_deploy() {
  local ref="${1:-}"; [[ -n "$ref" ]] || die "укажите commit: scripts/lab deploy <commit>"
  mkdir -p "$LAB_ROOT/releases"
  require_clean "$REPO"
  local sha; sha=$(git -C "$REPO" rev-parse --verify --quiet "$ref^{commit}") \
    || die "commit $ref не найден локально; выполните git fetch origin"
  local short=${sha:0:12} dest="$LAB_ROOT/releases/${sha:0:12}"
  [[ ! -e "$dest" ]] || die "$dest уже существует (версии неизменяемы; удалите вручную, если сборка битая и не активна)"
  local tmp="$dest.partial"
  rm -rf "$tmp"
  trap 'rm -rf "$tmp"' EXIT
  info "клонирую $short в $tmp"
  ( umask 077; git clone --quiet --no-checkout "$REPO" "$tmp" )
  git -C "$tmp" checkout --quiet --detach "$sha"
  git -C "$tmp" submodule --quiet init
  # Объекты submodules берём из локального checkout, а не из сети.
  local path name link
  while read -r name path; do
    link=$(git -C "$tmp" ls-tree HEAD "$path" | awk '{print $3}')
    [[ -n "$link" ]] || die "$path: нет gitlink в $short"
    git -C "$REPO/$path" cat-file -e "$link^{commit}" 2>/dev/null \
      || die "$path: в локальном submodule нет commit ${link:0:12}; выполните
  git -C $REPO/$path fetch origin $link"
    git -C "$tmp" config "submodule.$name.url" "$(git -C "$REPO/$path" rev-parse --absolute-git-dir)"
  done < <(git -C "$tmp" config -f .gitmodules --get-regexp '^submodule\..*\.path$' \
           | sed -E 's/^submodule\.(.*)\.path (.*)$/\1 \2/')
  git -C "$tmp" -c protocol.file.allow=always submodule --quiet update --recursive
  python3 "$tmp/scripts/check.py" "$tmp" || die "проверка $short не прошла"
  apply_patches "$tmp"
  cmd_build "$tmp"
  printf 'commit=%s\nbuilt_at=%s\nbuilt_by=%s\nrathena=%s\nopenkore=%s\n' \
    "$sha" "$(date -u +%FT%TZ)" "$(id -un)" \
    "$(git -C "$tmp" ls-tree HEAD upstream/rathena | awk '{print $3}')" \
    "$(git -C "$tmp" ls-tree HEAD upstream/openkore | awk '{print $3}')" > "$tmp/RELEASE"
  mv "$tmp" "$dest"
  trap - EXIT
  if [[ -L "$LAB_ROOT/current" ]]; then
    local cur; cur=$(current_release)
    if [[ -f "$cur/RELEASE" ]] && ! diff -q <(grep -E '^(rathena|openkore)=' "$cur/RELEASE") \
         <(grep -E '^(rathena|openkore)=' "$dest/RELEASE") >/dev/null; then
      warn "версия upstream отличается от current: проверьте sql-files/upgrades и совместимость OpenKore."
      warn "Миграции БД вручную, после scripts/lab db-backup."
    fi
  fi
  info "готово: $dest (не активирована). Дальше: scripts/lab stop && scripts/lab activate $short"
}

resolve_release() {
  local want="$1" matches=()
  [[ -d "$LAB_ROOT/releases/$want" ]] && { echo "$LAB_ROOT/releases/$want"; return; }
  local d
  for d in "$LAB_ROOT"/releases/"$want"*; do
    [[ -d "$d" && "$d" != *.partial ]] && matches+=("$d")
  done
  ((${#matches[@]} == 1)) || die "release '$want' не найден или неоднозначен"
  echo "${matches[0]}"
}

cmd_activate() {
  local target; target=$(resolve_release "${1:?укажите release}")
  [[ -f "$target/RELEASE" ]] || die "$target не завершён (нет RELEASE)"
  stack_running && die "стек запущен; сначала scripts/lab stop"
  local cur=""
  [[ -L "$LAB_ROOT/current" ]] && cur=$(readlink -f "$LAB_ROOT/current")
  [[ "$cur" == "$target" ]] && { info "уже активна $(basename "$target")"; return; }
  if [[ -n "$cur" ]]; then
    ln -sfn "$cur" "$LAB_ROOT/previous.new" && mv -T "$LAB_ROOT/previous.new" "$LAB_ROOT/previous"
  fi
  ln -sfn "$target" "$LAB_ROOT/current.new" && mv -T "$LAB_ROOT/current.new" "$LAB_ROOT/current"
  info "current -> $(basename "$target")${cur:+, previous -> $(basename "$cur")}"
  info "БД, state/ и logs/ не изменялись. Запуск: scripts/lab start"
}

cmd_rollback() {
  [[ -L "$LAB_ROOT/previous" ]] || die "нет previous для отката"
  cmd_activate "$(basename "$(readlink -f "$LAB_ROOT/previous")")"
}

cmd_releases() {
  local cur="" prev="" d mark
  [[ -L "$LAB_ROOT/current" ]] && cur=$(readlink -f "$LAB_ROOT/current")
  [[ -L "$LAB_ROOT/previous" ]] && prev=$(readlink -f "$LAB_ROOT/previous")
  for d in "$LAB_ROOT"/releases/*/; do
    d=${d%/}; [[ -d "$d" ]] || continue
    mark="  "; [[ "$d" == "$cur" ]] && mark="* "; [[ "$d" == "$prev" ]] && mark="< "
    printf '%s%s  %s\n' "$mark" "$(basename "$d")" "$(sed -n 's/^built_at=//p' "$d/RELEASE" 2>/dev/null || echo 'НЕЗАВЕРШЁН')"
  done
  echo "(* current, < previous)"
}

cmd_db_init() {
  need_var INTER_USER INTER_PASS BOT01_USER BOT01_PASS
  check_cred INTER_USER; check_cred INTER_PASS; check_cred BOT01_USER; check_cred BOT01_PASS
  local rel; rel=$(current_release)
  resolve_db
  sql "$DB_NAME" -e 'SELECT 1' >/dev/null || die "нет доступа к БД $DB_NAME (см. docs/SETUP.md)"
  local db n
  for db in "$DB_NAME" "$LOG_DB_NAME"; do
    n=$(sql "$db" -N -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE()")
    [[ "$n" == 0 ]] || die "в $db уже $n таблиц — db-init только для пустой БД. Миграции — вручную после db-backup."
  done
  info "загружаю main.sql в $DB_NAME и logs.sql в $LOG_DB_NAME из $(basename "$rel")"
  sql "$DB_NAME" < "$rel/upstream/rathena/sql-files/main.sql"
  sql "$LOG_DB_NAME" < "$rel/upstream/rathena/sql-files/logs.sql"
  sql "$DB_NAME" <<EOF
UPDATE login SET userid=$(sql_quote "$INTER_USER"), user_pass=$(sql_quote "$INTER_PASS") WHERE account_id=1;
INSERT INTO login (userid, user_pass, sex, email) VALUES ($(sql_quote "$BOT01_USER"), $(sql_quote "$BOT01_PASS"), $(sql_quote "${BOT01_SEX:-M}"), 'bot01@lab.local');
EOF
  info "БД инициализирована: inter-server и аккаунт bot01 созданы (персонаж не создан)"
}

cmd_db_backup() {
  resolve_db
  local dump; dump=$(command -v mariadb-dump || command -v mysqldump) || die "нет mariadb-dump/mysqldump"
  local ts db out; ts=$(date -u +%Y%m%dT%H%M%SZ)
  ( umask 077; mkdir -p "$LAB_ROOT/backups" )
  for db in $(printf '%s\n' "$DB_NAME" "$LOG_DB_NAME" | sort -u); do
    out="$LAB_ROOT/backups/${db}-${ts}.sql.gz"
    if ! ( umask 077; set -o pipefail
           "$dump" --defaults-extra-file=<(mycnf) --lock-tables --routines "$db" | gzip > "$out" ); then
      rm -f "$out"; die "дамп $db не удался"
    fi
    gzip -t "$out" || die "$out: архив повреждён"
    zcat "$out" | tail -n 1 | grep -q 'Dump completed' || die "$out: дамп не завершён (нет 'Dump completed')"
    info "бэкап: $out ($(stat -c %s "$out") байт, gzip и маркер завершения OK)"
  done
}

# ---------- запуск и остановка ----------

start_proc() { # start_proc NAME CWD LOG CMD...
  local name="$1" cwd="$2" log="$3"; shift 3
  local pid; pid=$(running_pid "$name")
  if [[ -n "$pid" ]]; then info "$name уже запущен (pid $pid, $(proc_user "$pid")) — не трогаю"; return; fi
  rotate_log "$log"
  ( cd "$cwd" || exit 1
    setsid nohup "$@" >>"$log" 2>&1 </dev/null &
    echo $! > "$PIDS/$name.pid" )
  info "$name запущен (pid $(<"$PIDS/$name.pid")), лог $log"
}

wait_port() {
  local name="$1" port="$2" i
  for ((i = 0; i < 60; i++)); do
    port_open "$port" && { info "$name слушает ${BIND_IP:-127.0.0.1}:$port"; return; }
    [[ -n "$(running_pid "$name")" ]] || die "$name завершился; см. $LAB_ROOT/logs/rathena/$name.log"
    sleep 1
  done
  die "$name не открыл порт $port за 60 с"
}

start_server() {
  local rd; rd=$(rathena_dir)
  if render_server_conf; then
    local pr; pr=$(profile_root)
    python3 "$pr/scripts/lib/render.py" server "$pr/server/conf/import-tmpl" \
      "$rd/conf/import" "$LAB_ENV" "$LAB_ROOT"
  fi
  local s pid
  for s in "${SERVERS[@]}"; do
    pid=$(running_pid "$s")
    if [[ -z "$pid" ]] && port_open "${PORT[$s]}"; then
      die "порт ${PORT[$s]} занят процессом, не найденным как $s-server из $rd — разберитесь вручную"
    fi
    start_proc "$s" "$rd" "$LAB_ROOT/logs/rathena/$s.log" "./$s-server"
    wait_port "$s" "${PORT[$s]}"
  done
  info "login/char/map работают (вход в игру этой командой не проверяется)"
}

start_bot() {
  local bot="$1" pr od; pr=$(profile_root); od=$(openkore_dir)
  [[ -f "$od/openkore.pl" ]] || die "нет $od/openkore.pl"
  local pid; pid=$(running_pid "$bot")
  [[ -z "$pid" ]] || { info "$bot уже запущен (pid $pid, $(proc_user "$pid")) — не трогаю"; return; }
  local ctl var="${bot^^}_CONTROL_DIR"
  if is_set "$var"; then
    ctl=$(readlink -f "${!var}")
    warn "$bot: используется готовый control $ctl — профиль и fallback из Git НЕ применяются"
  else
    [[ -d "$pr/bots/$bot/control" ]] || die "нет профиля bots/$bot в $pr"
    local u="${bot^^}_USER" p="${bot^^}_PASS"
    need_var "$u" "$p"; check_cred "$u"; check_cred "$p"
    ctl="$LAB_ROOT/run/bots/$bot/control"
    ( umask 077; mkdir -p "$(dirname "$ctl")" )
    python3 "$pr/scripts/lib/render.py" bot "$pr/bots/$bot/control" "$ctl" "$LAB_ENV" "$bot"
  fi
  mkdir -p "$LAB_ROOT/logs/$bot" "$LAB_ROOT/state/$bot"
  # Старая сессия ещё держится на сервере -> вход получит "still recognizes your
  # last connection". Ждём ограниченно; затем запускаем (OpenKore повторит вход сам).
  if [[ "$(bot_online "$bot")" == 1 ]]; then
    info "$bot: персонаж ещё online на сервере — жду снятия сессии до 60 с"
    wait_offline "$bot" 60 || warn "$bot: запускаю всё равно; OpenKore повторит вход сам"
  fi
  local tables="$od/tables" plugins="$od/plugins"
  [[ -d "$pr/bots/$bot/tables" ]] && tables="$pr/bots/$bot/tables:$tables"
  [[ -d "$pr/bots/plugins" ]] && plugins="$pr/bots/plugins:$plugins"
  local -a cmd=(env "LIVE_RO_BRAIN_SOCKET=$LAB_ROOT/run/brain/$bot.sock" "LIVE_RO_COMBAT=$pr/bots/combat/classes.json"
                perl openkore.pl --control="$ctl" --tables="$tables" --plugins="$plugins"
                --logs="$LAB_ROOT/logs/$bot")
  local log="$LAB_ROOT/logs/$bot/console.log"
  rotate_log "$log"
  log_mark "$bot" START
  local rv="${bot^^}_RUNNER"
  if [[ "${!rv:-${BOT_RUNNER:-tmux}}" == tmux ]] && command -v tmux >/dev/null; then
    local sess="live_ro_$bot" q
    tmux has-session -t "$sess" 2>/dev/null && die "tmux-сессия $sess уже существует"
    q=$(printf '%q ' "${cmd[@]}")
    tmux new-session -d -s "$sess" -c "$od" "exec $q"
    tmux pipe-pane -o -t "$sess" "cat >> $(printf '%q' "$log")"
    tmux display-message -p -t "$sess" '#{pane_pid}' > "$PIDS/$bot.pid"
    info "$bot запущен в tmux ($sess, pid $(<"$PIDS/$bot.pid")): tmux attach -t $sess; лог $log"
  else
    # Без терминала OpenKore читает $ENV{TERM} и сыплет предупреждениями, если его нет.
    start_proc "$bot" "$od" "$log" env TERM=dumb "${cmd[@]}" --interface=Console::Simple
  fi
}

# Мозг бота (brain/live_brain): решения и общение, память в state/<bot>. Процесс brain-<bot>.
start_brain() {
  local bot="$1" pr; pr=$(profile_root)
  command -v python3 >/dev/null || die "нет python3"
  [[ -d "$pr/brain/live_brain" ]] || die "нет $pr/brain/live_brain"
  [[ -f "$pr/brain/personas/$bot.json" ]] || die "нет характера brain/personas/$bot.json"
  if [[ "${BRAIN_LLM:-off}" != openrouter ]]; then
    info "$bot: BRAIN_LLM=off — мозг на правилах, без платных вызовов"
  fi
  mkdir -p "$LAB_ROOT/logs/$bot"
  ( umask 077; mkdir -p "$LAB_ROOT/run/brain" "$LAB_ROOT/state/$bot" )
  rotate_log "$LAB_ROOT/logs/$bot/brain.log"
  start_proc "brain-$bot" "$pr/brain" "$LAB_ROOT/logs/$bot/brain.log" \
    python3 -m live_brain --env "$LAB_ENV" --bot "$bot" --lab-root "$LAB_ROOT"
  info "$bot: журнал решений $LAB_ROOT/state/$bot/decisions.jsonl"
}

cmd_brain_check() { # cmd_brain_check --check|--check-jev [BOT]
  load_env
  local flag="$1" bot; bot=$(bots_arg "${2:-bot01}" | head -n1)
  local pr; pr=$(profile_root)
  ( cd "$pr/brain" && python3 -m live_brain --env "$LAB_ENV" --bot "$bot" --lab-root "$LAB_ROOT" "$flag" )
}

# ---------- сторож: самостоятельная жизнь без оператора ----------

SUP_CHECK=${LAB_SUP_CHECK:-30}   # проверка раз в 30 с (LAB_SUP_CHECK — для тестов)
SUP_WINDOW=1800       # окно подсчёта перезапусков
SUP_MAX=5             # больше перезапусков в окне — не перезапускать, ждать окно

sup_log() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$LAB_ROOT/logs/supervisor.log"; }

# AUT-105: желаемое состояние. stop botNN|brain|live — отметка «остановлен владельцем», сторож такой
# процесс не поднимает; start/up снимают отметку.
hold_file() { echo "$LAB_ROOT/run/supervisor/$1.held"; }
hold() { local n; ( umask 077; mkdir -p "$LAB_ROOT/run/supervisor" ); for n in "$@"; do : > "$(hold_file "$n")"; done; }
release() { local n; for n in "$@"; do rm -f "$(hold_file "$n")"; done; }
held() { [[ -f "$(hold_file "$1")" ]]; }

# AUT-118: оповещение владельцу в run/alerts.log (один вид от процесса — не чаще раза в час).
sup_alert() {
  local name="$1" text="$2" mark="$LAB_ROOT/run/supervisor/$1.alerted" now; now=$(date +%s)
  if [[ -f "$mark" ]] && (( now - $(<"$mark") < 3600 )); then return 0; fi
  echo "$now" > "$mark"
  python3 -c 'import json,sys,time; print(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "bot": sys.argv[1], "kind": "supervisor", "text": sys.argv[2]}, ensure_ascii=False))' \
    "$name" "$text" >> "$LAB_ROOT/run/alerts.log"
}

sup_restart() { # sup_restart NAME CMD... — перезапуск с ограничением частоты
  local name="$1"; shift
  held "$name" && return 0                              # остановлен владельцем — не поднимать
  local f="$LAB_ROOT/run/supervisor/$name.restarts" now; now=$(date +%s)
  local recent=0 t
  if [[ -f "$f" ]]; then
    while read -r t; do (( now - t < SUP_WINDOW )) && recent=$((recent + 1)); done < "$f"
  fi
  if (( recent >= SUP_MAX )); then
    sup_log "$name: упал $recent раз за $((SUP_WINDOW / 60)) мин — не перезапускаю до конца окна"
    sup_alert "$name" "упал $recent раз за $((SUP_WINDOW / 60)) мин — сторож перестал перезапускать до конца окна"
    return
  fi
  echo "$now" >> "$f"
  sup_log "$name: не запущен — перезапускаю ($((recent + 1))/$SUP_MAX за окно)"
  ( "$@" ) >> "$LAB_ROOT/logs/supervisor.log" 2>&1 || sup_log "$name: перезапуск не удался (см. выше)"
}

# ORG-044: диспетчер смен. Без LAB_MAX_ONLINE — все боты LAB_BOTS (прежнее поведение). С ним — не больше N
# бодрствующих по хронотипу (persona.sleep, scripts/lib/roster.py shift), по порядку LAB_BOTS; спящих не будим.
# Запущенных сторож не останавливает: засыпание — relog внутри OpenKore (мозг), лимит действует на подъём.
shift_bots() {
  if [[ -z "${LAB_MAX_ONLINE:-}" ]]; then lab_bots; return; fi
  [[ "$LAB_MAX_ONLINE" =~ ^[0-9]+$ ]] || die "LAB_MAX_ONLINE должен быть числом (сейчас '$LAB_MAX_ONLINE')"
  local pr out; pr=$(profile_root)
  if out=$(python3 "$pr/scripts/lib/roster.py" --repo "$pr" shift --max "$LAB_MAX_ONLINE" --bots "$(lab_bots | tr '\n' ' ')"); then
    awk '$2 == "awake" {print $1}' <<<"$out"
  else
    warn "диспетчер смен не ответил — беру первых $LAB_MAX_ONLINE из LAB_BOTS"
    local -a all; mapfile -t all < <(lab_bots)
    printf '%s\n' "${all[@]:0:$LAB_MAX_ONLINE}"
  fi
}

online_count() { # сколько ботов LAB_BOTS сейчас запущено (процесс OpenKore есть)
  local b n=0
  for b in $(lab_bots); do [[ -n "$(running_pid "$b")" ]] && n=$((n + 1)); done
  echo "$n"
}

may_start_bot() { # may_start_bot BOT ALLOWED... — можно ли поднять бота при LAB_MAX_ONLINE (без лимита — всегда)
  local bot="$1"; shift
  [[ -z "${LAB_MAX_ONLINE:-}" ]] && return 0
  [[ " $* " == *" $bot "* ]] || return 1
  asleep_until "$bot" >/dev/null && return 1      # ops: ORG-044 спит по флагу мозга — не будим
  (( $(online_count) < LAB_MAX_ONLINE ))
}

# ops: ORG-044 мягкая смена. Онлайн (процессов тел) больше LAB_MAX_ONLINE — бодрствующих не убиваем, а просим
# мозг уснуть раньше (команда sleep в run/brain/BOT.inbox — тот же канал, что scripts/lab plan; мозг уходит в
# город и засыпает штатно, relog). Уснувший житель (флаг run/brain/BOT.asleep с часом пробуждения пишет мозг)
# освобождает процесс тела: штатная остановка SIGTERM (gracefulStop), не kill -9; до пробуждения тело не
# поднимается. Порядок: сначала спящие по хронотипу, потом «сверх лимита»; бодрствующие из смены не трогаются.
SHIFT_ASK_GAP=1800                        # повторная просьба тому же жителю — не раньше чем через 30 мин
SHIFT_NAP_H=${LAB_SHIFT_NAP_HOURS:-2}     # на сколько часов уснуть раньше (своя ночь ближе — до её конца)
SHIFT_FREE_MIN=600                        # освобождать процесс, если до пробуждения больше 10 мин

asleep_until() { # asleep_until BOT -> час пробуждения (unix) из флага мозга, если он в будущем
  local f="$LAB_ROOT/run/brain/$1.asleep" t=""
  [[ -f "$f" ]] || return 1
  read -r t < "$f" || true
  [[ "$t" =~ ^[0-9]+$ ]] && (( t > $(date +%s) )) && echo "$t"
}

shift_states() { # строки "botNN awake|asleep|limit" (scripts/lib/roster.py shift)
  local pr; pr=$(profile_root)
  python3 "$pr/scripts/lib/roster.py" --repo "$pr" shift --max "$LAB_MAX_ONLINE" --bots "$(lab_bots | tr '\n' ' ')"
}

ask_sleep() { # ask_sleep BOT ONLINE — просьба мозгу уснуть раньше, не чаще SHIFT_ASK_GAP
  local b="$1" mark="$LAB_ROOT/run/supervisor/$1.bedtime" now; now=$(date +%s)
  if [[ -f "$mark" ]] && (( now - $(<"$mark") < SHIFT_ASK_GAP )); then return 0; fi
  if [[ -z "$(running_pid "brain-$b")" ]]; then
    sup_log "$b: онлайн $2 > LAB_MAX_ONLINE=$LAB_MAX_ONLINE, но мозг не запущен — просить некого"; return 0
  fi
  [[ "$SHIFT_NAP_H" =~ ^[0-9]+([.][0-9]+)?$ ]] || SHIFT_NAP_H=2
  echo "$now" > "$mark"
  ( umask 077; mkdir -p "$LAB_ROOT/run/brain"
    printf '{"cmd": "sleep", "hours": %s, "ts": %s, "by": "supervisor"}\n' "$SHIFT_NAP_H" "$now" >> "$LAB_ROOT/run/brain/$b.inbox" )
  sup_log "$b: онлайн $2 > LAB_MAX_ONLINE=$LAB_MAX_ONLINE — прошу мозг уснуть раньше (на $SHIFT_NAP_H ч)"
}

shift_balance() { # один проход сторожа при LAB_MAX_ONLINE
  [[ -n "${LAB_MAX_ONLINE:-}" ]] || return 0
  local b st wake states n over now; local -a cand; now=$(date +%s)
  for b in $(lab_bots); do                          # 1) уснувшие освобождают процесс
    wake=$(asleep_until "$b") || continue
    if [[ -z "$(running_pid "$b")" ]] || (( wake - now <= SHIFT_FREE_MIN )); then continue; fi
    sup_log "$b: спит до $(date -d "@$wake" +%H:%M 2>/dev/null || echo "$wake") — освобождаю процесс тела (SIGTERM)"
    ( stop_bot "$b" 0 ) >> "$LAB_ROOT/logs/supervisor.log" 2>&1 || sup_log "$b: остановка тела не удалась (см. выше)"
  done
  n=$(online_count); over=$(( n - LAB_MAX_ONLINE ))
  (( over > 0 )) || return 0
  states=$(shift_states) || { sup_log "диспетчер смен не ответил — мягкая смена пропущена"; return 0; }
  for st in asleep limit; do                        # 2) лишние: спящие по хронотипу, затем сверх лимита
    mapfile -t cand < <(awk -v s="$st" '$2 == s {print $1}' <<<"$states")
    for b in "${cand[@]}"; do
      (( over > 0 )) || return 0
      [[ -n "$(running_pid "$b")" ]] || continue
      over=$((over - 1))
      asleep_until "$b" >/dev/null && continue      # уже спит, скоро проснётся — не просить
      ask_sleep "$b" "$n"
    done
  done
}

# ops: ORG-047 замер ресурсов по /proc (brain/live_brain/resources.py); сторож пишет историю раз в 10 мин.
RES_EVERY=${LAB_RES_EVERY:-600}
resources_py() { # resources_py [--sample]
  local pr; pr=$(profile_root)
  # shellcheck disable=SC2046
  ( cd "$pr/brain" && python3 -m live_brain.resources --lab-root "$LAB_ROOT" --bots $(lab_bots) "$@" )
}
cmd_resources() { load_env; resources_py; }

cmd_modules() { # rollout: какие модули мозга создадутся при старте (только чтение; docs/ROLLOUT.md)
  load_env
  local bot="" disable="${BRAIN_DISABLE:-}" src="env"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      bot[0-9]*) bot="$1" ;;
      --disable) disable="${2:-}"; src="--disable"; shift ;;
      *) die "scripts/lab modules [BOT] [--disable СПИСОК]" ;;
    esac
    shift
  done
  bot="${bot:-$(lab_bots | head -n1)}"
  local pr; pr=$(profile_root)
  ( cd "$pr/brain" && python3 - "$bot" "$disable" "$src" "$(lab_bots | tr '\n' ' ')" <<'PY'
import json, sys
from types import SimpleNamespace
from live_brain.config import Settings
from live_brain.modules import MODULES
from live_brain.__main__ import peer_names
bot, disable, src, bots = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4].split()
s = Settings.from_env({"BRAIN_DISABLE": disable})
world = json.load(open("world/goals.json", encoding="utf-8"))
persona = json.load(open(f"personas/{bot}.json", encoding="utf-8"))
peers = peer_names(f"personas/{bot}.json", bots or None) - {persona["name"]}
mind = SimpleNamespace(s=s, ctx=SimpleNamespace(peers=peers))
known = {getattr(c, "FEATURE", None) for c in MODULES} | {"world_bus", "grammar", "weather", "topics"}
print(f"{bot} ({persona['name']}): жители {sorted(peers) or 'нет'}; BRAIN_DISABLE ({src}): {disable or '—'}")
for name in sorted(s.disabled - known):
    print(f"  ВНИМАНИЕ: '{name}' в BRAIN_DISABLE не выключает ни один модуль (опечатка?)")
names = {c.ATTR: getattr(c, "FEATURE", None) or c.ATTR for c in MODULES}
on = []
for cls in MODULES:
    cfg = (world.get(getattr(cls, "CONFIG", None) or "") or {})
    why = ""
    for req in getattr(cls, "REQUIRES", ()):
        if req == "peers" and not peers:
            why = "нет других жителей в LAB_BOTS"
        elif req == "config" and not cfg:
            why = f"нет раздела {cls.CONFIG} в goals.json"
        elif req not in ("world", "peers", "config") and not getattr(mind, req, None):
            why = f"нет модуля {names.get(req, req)}"
        if why:
            break
    feature = getattr(cls, "FEATURE", None) or ("world_bus" if cls.ATTR == "world" else None)
    if not why and feature and not s.feature(feature):
        why = f"BRAIN_DISABLE={feature}"
    default = getattr(cls, "ENABLED", None)
    if not why and default is not None and not cfg.get("enabled", default):
        why = f"goals.json {cls.CONFIG}.enabled: false"
    setattr(mind, cls.ATTR, None if why else True)
    if why:
        print(f"  выкл.  {feature or cls.ATTR:<12} {why}")
    else:
        on.append(feature or cls.ATTR)
print(f"  вкл. ({len(on)}): {', '.join(on)}")
flags = [("progression", "auto_job_change"), ("routine", "auto_hunt_maps"), ("routine", "vend_in_town"),
         ("savings", "bank"), ("achieve", "claim_rewards"), ("arrows", "quest_auto"), ("guild", "emperium_check"),
         ("explore", "group"), ("trek", "halt_save")]
print("  флаги goals.json: " + ", ".join(f"{a}.{b}={(world.get(a) or {}).get(b, '—')}" for a, b in flags))
PY
  )
}

cmd_supervise() {
  load_env
  ( umask 077; mkdir -p "$LAB_ROOT/run/supervisor" )
  sup_log "сторож запущен: боты $(lab_bots | tr '\n' ' ')${LAB_MAX_ONLINE:+, онлайн не больше $LAB_MAX_ONLINE}"
  trap 'sup_log "сторож остановлен"; exit 0' TERM INT
  local b warned=0 allowed res_at=$(( -RES_EVERY ))
  while true; do
    if (( SECONDS - res_at >= RES_EVERY )); then    # ops: ORG-047 история RSS/CPU для report
      res_at=$SECONDS; resources_py --sample >/dev/null 2>&1 || sup_log "замер ресурсов не удался"
    fi
    if port_open "${PORT[map]}"; then
      warned=0
      allowed=$(shift_bots | tr '\n' ' ')
      for b in $(lab_bots); do
        [[ -n "$(running_pid "brain-$b")" ]] || sup_restart "brain-$b" start_brain "$b"
        if [[ -z "$(running_pid "$b")" ]] && may_start_bot "$b" "$allowed"; then sup_restart "$b" start_bot "$b"; fi
      done
      shift_balance                                 # ops: ORG-044 мягкая смена
    elif (( ! warned )); then
      sup_log "map-server не отвечает на порту ${PORT[map]} — боты не перезапускаются, жду сервер"
      warned=1
    fi
    sleep "$SUP_CHECK" & wait $!
  done
}

cmd_up() {
  load_env
  mkdir -p "$PIDS" "$LAB_ROOT/logs"
  port_open "${PORT[map]}" || die "map-server не отвечает на порту ${PORT[map]}: сначала scripts/lab start (серверы)"
  local b allowed; allowed=$(shift_bots | tr '\n' ' ')
  for b in $(lab_bots); do
    release "$b" "brain-$b"; start_brain "$b"
    if may_start_bot "$b" "$allowed"; then start_bot "$b"
    else info "$b: смена (LAB_MAX_ONLINE=$LAB_MAX_ONLINE) — спит по хронотипу или лимит онлайн; поднимет сторож"; fi
  done
  start_proc supervisor "$REPO" "$LAB_ROOT/logs/supervisor.out" \
    env "LAB_ROOT=$LAB_ROOT" "LAB_ENV=$LAB_ENV" bash "$REPO/scripts/lab" supervise
  info "жители запущены, сторож следит за ними (лог $LAB_ROOT/logs/supervisor.log). Сводка: scripts/lab report"
}

cmd_down() {
  if [[ -f "$LAB_ENV" ]]; then load_env; fi
  stop_proc supervisor 0
  cmd_stop live all
  info "жители остановлены; серверы работают (остановка серверов: scripts/lab stop server)"
}

cmd_report() {
  load_env
  local pr b; pr=$(profile_root)
  cmd_status_body
  for b in $(lab_bots); do
    ( cd "$pr/brain" && python3 -m live_brain --env "$LAB_ENV" --bot "$b" --lab-root "$LAB_ROOT" --report ) || true
  done
  if [[ -f "$LAB_ROOT/logs/supervisor.log" ]]; then
    echo "== сторож (последние события)"; tail -n 5 "$LAB_ROOT/logs/supervisor.log"
  fi
  if [[ -s "$LAB_ROOT/run/alerts.log" ]]; then
    echo "== оповещения (нужно внимание владельца; все: scripts/lab alerts)"; tail -n 5 "$LAB_ROOT/run/alerts.log"
  fi
  resources_py || true                              # ops: ORG-047
}

# Команда оператора мозгу: строка JSON в run/brain/<bot>.inbox (мозг читает раз в секунду).
cmd_plan() {
  local bot="${1:-}" sub="${2:-}" who="${3:-}"
  [[ "$bot" =~ ^bot[0-9]+$ ]] || die "scripts/lab plan botNN meet ИМЯ|cancel|show"
  load_env
  local pr; pr=$(profile_root)
  case "$sub" in
    show)
      ( cd "$pr/brain" && python3 -m live_brain --env "$LAB_ENV" --bot "$bot" --lab-root "$LAB_ROOT" --plans ) ;;
    meet|cancel|rest|hunt)
      [[ -n "$(running_pid "brain-$bot")" ]] || die "мозг $bot не запущен: scripts/lab start brain $bot"
      if [[ "$sub" == meet ]]; then
        [[ "$who" =~ ^[^\"[:cntrl:]]{1,23}$ ]] || die "укажите имя жителя: scripts/lab plan $bot meet Arkady"
      fi
      ( umask 077; python3 -c 'import json,sys,time; print(json.dumps({"cmd": sys.argv[1], "with": sys.argv[2], "ts": time.time()}, ensure_ascii=False))' \
          "$sub" "$who" >> "$LAB_ROOT/run/brain/$bot.inbox" )
      info "команда передана мозгу $bot: $sub $who — исполнится после первого состояния тела, не позже 10 мин (результат: decisions.jsonl \"operator\")" ;;
    *) die "scripts/lab plan botNN meet ИМЯ|cancel|show" ;;
  esac
}

# Просьба жителю рядом (проверка обмена): мозг пропускает проверку нехватки и интервала.
cmd_gift() {
  local bot="${1:-}" item="${2:-}" n="${3:-}"
  [[ "$bot" =~ ^bot[0-9]+$ && "$item" =~ ^([0-9]{1,6}|z)$ && "$n" =~ ^[0-9]{1,7}$ ]] \
    || die "scripts/lab gift botNN ITEM|z N   (например: gift bot02 501 10)"
  load_env
  [[ -n "$(running_pid "brain-$bot")" ]] || die "мозг $bot не запущен: scripts/lab start brain $bot"
  ( umask 077; python3 -c 'import json,sys,time; print(json.dumps({"cmd": "ask", "item": sys.argv[1], "amount": int(sys.argv[2]), "ts": time.time()}))' \
      "$item" "$n" >> "$LAB_ROOT/run/brain/$bot.inbox" )
  info "команда передана мозгу $bot: попросить $n x $item (итог: scripts/lab report, decisions.jsonl \"economy\")"
}

# Новый игровой аккаунт для бота. Пишет в БД игры, поэтому требует бэкап не старше 24 ч.
cmd_db_add_account() {
  local bot="${1:-}"; [[ "$bot" =~ ^bot[0-9]+$ ]] || die "укажите бота: scripts/lab db-add-account bot02"
  load_env
  local u="${bot^^}_USER" p="${bot^^}_PASS" sx="${bot^^}_SEX"
  need_var "$u" "$p"; check_cred "$u"; check_cred "$p"
  [[ "${!sx:-M}" =~ ^[MF]$ ]] || die "$sx должен быть M или F"
  resolve_db
  local recent
  recent=$(find "$LAB_ROOT/backups" -maxdepth 1 -name "${DB_NAME}-*.sql.gz" -mmin -1440 2>/dev/null | head -n1)
  [[ -n "$recent" ]] || die "нет бэкапа $DB_NAME за последние 24 ч: сначала scripts/lab db-backup"
  [[ -z "$(sql "$DB_NAME" -N -e "SELECT account_id FROM login WHERE userid=$(sql_quote "${!u}")")" ]] \
    || die "аккаунт ${!u} уже существует — ничего не меняю"
  # SQL через stdin: при ошибке клиент не печатает запрос (а в нём пароль).
  sql "$DB_NAME" <<<"INSERT INTO login (userid, user_pass, sex, email) VALUES ($(sql_quote "${!u}"), $(sql_quote "${!p}"), $(sql_quote "${!sx:-M}"), '$bot@lab.local');"
  info "аккаунт $bot создан: account_id $(sql "$DB_NAME" -N -e "SELECT account_id FROM login WHERE userid=$(sql_quote "${!u}")"); бэкап до изменения: $recent"
  info "персонаж создаётся при первом входе: плагин autoCreate (config autoCreate 1, имя из реестра) или консоль OpenKore в tmux (tmux attach -t live_ro_$bot)"
}

# ---------- население (ORG-040..043, docs/POPULATION.md) ----------

# Реестр жителей правит файлы checkout ($REPO), не runtime и не БД.
cmd_roster() {
  local sub="${1:-check}"; shift || true
  case "$sub" in
    check) if [[ -f "$LAB_ENV" ]]; then load_env; fi
           python3 "$REPO/scripts/lib/roster.py" --repo "$REPO" check --bots "$(lab_bots | tr '\n' ' ')" ;;
    sync)  python3 "$REPO/scripts/lib/roster.py" --repo "$REPO" sync "$@" ;;
    *) die "scripts/lab roster check|sync [--write]" ;;
  esac
}

cmd_new_resident() {
  (( $# >= 3 )) || die "scripts/lab new-resident botNN ШАБЛОН ИМЯ [--sex M|F] [--persona FILE] (шаблоны: bots/templates)"
  python3 "$REPO/scripts/lib/roster.py" --repo "$REPO" new "$@"
  info "секретов в профиле нет: логин/пароль — ${1^^}_USER/${1^^}_PASS/${1^^}_SEX в $LAB_ENV на VPS. Проверьте git diff и закоммитьте."
}

# ORG-043: рождение жителя. Без --yes только проверяет и печатает шаги; с --yes вызывает db-backup (если нет
# бэкапа за 24 ч) и db-add-account BOT. Запуск бота, реестр, LAB_BOTS — шаги оператора (печатаются).
cmd_birth() {
  local bot="${1:-}" yes=0
  [[ "$bot" =~ ^bot[0-9]+$ ]] || die "scripts/lab birth botNN [--yes]"
  [[ "${2:-}" == --yes ]] && yes=1
  load_env
  local pr; pr=$(profile_root)
  local u="${bot^^}_USER" p="${bot^^}_PASS" sx="${bot^^}_SEX" recent="" account=""
  echo "== 1. профиль, персона, реестр ($pr)"
  python3 "$pr/scripts/lib/roster.py" --repo "$pr" birth "$bot" || DOC_FAIL=1
  echo "== 2. учётные данные в $LAB_ENV (значения не печатаются)"
  if is_set "$u" && cred_ok "$u"; then ok "$u задан"; else bad "$u: заполните (1-23 ASCII без пробелов)"; fi
  if is_set "$p" && cred_ok "$p"; then ok "$p задан"; else bad "$p: заполните (1-23 ASCII без пробелов)"; fi
  if [[ "${!sx:-}" =~ ^[MF]$ ]]; then ok "$sx=${!sx}"; else bad "$sx: M или F (пол аккаунта и персонажа)"; fi
  echo "== 3. бэкап БД не старше 24 ч и аккаунт (только SELECT)"
  if ( resolve_db ) 2>/dev/null; then
    resolve_db
    recent=$(find "$LAB_ROOT/backups" -maxdepth 1 -name "${DB_NAME}-*.sql.gz" -mmin -1440 2>/dev/null | head -n1)
    if [[ -n "$recent" ]]; then ok "бэкап $recent"; else note "свежего бэкапа нет (db-add-account его требует)"; fi
    if is_set "$u"; then
      account=$(sql "$DB_NAME" -N -e "SELECT account_id FROM login WHERE userid=$(sql_quote "${!u}")" 2>/dev/null || true)
      if [[ -n "$account" ]]; then note "аккаунт уже есть (account_id $account)"; else note "аккаунта нет"; fi
    fi
  else
    bad "реквизиты БД не определены"
  fi
  if ((yes)); then
    ((DOC_FAIL == 0)) || die "есть [FAIL] — исправьте и повторите"
    if [[ -z "$recent" ]]; then info "db-backup перед изменением БД"; cmd_db_backup; fi
    if [[ -z "$account" ]]; then cmd_db_add_account "$bot"; else info "аккаунт уже есть — db-add-account пропущен"; fi
  else
    echo "== с --yes будет выполнено:${recent:+ (бэкап свежий)}${recent:- scripts/lab db-backup;}${account:+ (аккаунт есть)}${account:- scripts/lab db-add-account $bot}"
  fi
  cat <<STEPS
== дальше — оператор (docs/POPULATION.md, «Рождение жителя»):
  4. первый вход: scripts/lab start live $bot  (autoCreate создаёт персонажа с именем из реестра; отказ сервера —
     метка $LAB_ROOT/logs/$bot/autoCreate.refused, повторов нет)
  5. проверка входа: scripts/lab doctor (строка $bot: имя, slot, map) и $LAB_ROOT/logs/$bot/console.log
  6. в Git: roster.json $bot active: true, born: $(date -u +%F); scripts/lab roster sync --write; commit;
     доставка (existing: git pull в checkout; release: deploy/activate)
  7. $LAB_ENV: LAB_BOTS += $bot; scripts/lab down && scripts/lab up (residents других обновит рендер)
STEPS
  ((DOC_FAIL == 0)) || return 1
}

cmd_start() {
  load_env
  mkdir -p "$PIDS"
  local what="${1:-server}"
  case "$what" in
    server) start_server ;;
    bot[0-9]*) release "$what"; start_bot "$what" ;;
    brain) for b in $(bots_arg "${2:-}"); do release "brain-$b"; start_brain "$b"; done ;;
    # Сначала мозг: иначе событие входа в игру может прийти раньше, чем мозг слушает сокет.
    live) for b in $(bots_arg "${2:-}"); do release "$b" "brain-$b"; start_brain "$b"; start_bot "$b"; done ;;
    *) die "start server|botNN|brain [BOT|all]|live [BOT|all]" ;;
  esac
}

stop_proc() {
  local name="$1" force="$2" line pid owner i
  line=$(first_proc "$name")
  [[ -n "$line" ]] || { rm -f "$PIDS/$name.pid"; return 0; }
  pid=${line%% *}; owner=$(proc_user "$pid")
  [[ "$owner" == "$(id -un)" ]] || die "$name (pid $pid) принадлежит $owner — остановите от его имени"
  info "останавливаю $name (pid $pid)"
  kill -TERM "$pid"
  for ((i = 0; i < 60; i++)); do
    kill -0 "$pid" 2>/dev/null || { rm -f "$PIDS/$name.pid"; return 0; }
    sleep 1
  done
  if [[ "$force" == 1 ]]; then
    warn "$name не завершился за 60 с — SIGKILL (несохранённые данные могут потеряться)"
    kill -KILL "$pid"; rm -f "$PIDS/$name.pid"
  else
    die "$name не завершился за 60 с; повторите с --force"
  fi
}

# Бот: SIGTERM -> плагин gracefulStop запрашивает выход у сервера (до 40 с),
# затем проверяем по БД, что сервер действительно снял персонажа.
stop_bot() {
  local bot="$1" force="$2" was
  was=$(running_pid "$bot")
  stop_proc "$bot" "$force"
  [[ -n "$was" ]] || return 0
  [[ -d "$LAB_ROOT/logs/$bot" ]] && log_mark "$bot" STOP
  local t0=$SECONDS
  wait_offline "$bot" 30 || true
  info "$bot: от завершения процесса до проверки offline прошло $((SECONDS - t0)) с"
}

cmd_stop() {
  local what="" which="" force=0 a
  for a in "$@"; do
    if [[ "$a" == --force ]]; then force=1
    elif [[ -z "$what" ]]; then what="$a"
    else which="$a"; fi
  done
  what=${what:-all}
  if [[ -f "$LAB_ENV" ]]; then load_env; fi
  local bots f n
  mapfile -t bots < <(lab_bots)
  for f in "$PIDS"/bot*.pid; do
    [[ -e "$f" ]] || continue
    n=$(basename "$f" .pid); [[ " ${bots[*]} " == *" $n "* ]] || bots+=("$n")
  done
  case "$what" in
    all)    for n in "${bots[@]}"; do hold "$n" "brain-$n"; stop_proc "brain-$n" "$force"; done
            for n in "${bots[@]}"; do stop_bot "$n" "$force"; done
            for n in map char login; do stop_proc "$n" "$force"; done ;;
    server) for n in map char login; do stop_proc "$n" "$force"; done ;;
    bot[0-9]*) hold "$what"; stop_bot "$what" "$force" ;;
    brain) for n in $(bots_arg "$which"); do hold "brain-$n"; stop_proc "brain-$n" "$force"; done ;;
    live) for n in $(bots_arg "$which"); do hold "$n" "brain-$n"; stop_proc "brain-$n" "$force"; stop_bot "$n" "$force"; done ;;
    *) die "stop server|botNN|brain [BOT|all]|live [BOT|all]|all" ;;
  esac
  info "остановлено: $what"
}

cmd_status_body() {
  local s line pid owner extra port
  local procs=("${SERVERS[@]}" supervisor) b
  for b in $(lab_bots); do procs+=("$b" "brain-$b"); done
  for s in "${procs[@]}"; do
    line=$(first_proc "$s")
    if [[ -n "$line" ]]; then
      read -r pid owner extra <<<"$line"
      line="pid $pid ($owner)${extra:+, $extra}"
      [[ -f "$PIDS/$s.pid" && "$(<"$PIDS/$s.pid")" == "$pid" ]] || line+=", запущен не через lab"
    else
      line="не запущен"
      held "$s" && line+=" (остановлен владельцем — сторож не поднимает; запуск: scripts/lab start)"
    fi
    port=${PORT[$s]:-}
    if [[ -n "$port" ]]; then
      if port_open "$port"; then line+=", порт $port открыт"; else line+=", порт $port закрыт"; fi
    fi
    printf '  %-12s %s\n' "$s" "$line"
  done
  echo "  (процессы и порты — не доказательство входа и игры бота)"
}

cmd_status() {
  if [[ -f "$LAB_ENV" ]]; then load_env; fi
  if existing_mode; then
    info "режим existing: rAthena $(rathena_dir)"
  elif [[ -L "$LAB_ROOT/current" ]]; then
    info "режим release: current $(basename "$(readlink -f "$LAB_ROOT/current")")"
  else
    info "режим release: активной версии нет"
  fi
  cmd_status_body
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    ""|-h|--help|help) usage; return ;;
    check) cmd_check "$@"; return ;;
  esac
  guard_user
  case "$sub" in
    prepare)   cmd_prepare ;;
    doctor)    cmd_doctor ;;
    status)    cmd_status ;;
    releases)  cmd_releases ;;
    start)     cmd_start "$@" ;;
    stop)      cmd_stop "$@" ;;
    db-backup) load_env; cmd_db_backup ;;
    brain-check) cmd_brain_check --check "${1:-}" ;;
    brain-check-jev) cmd_brain_check --check-jev "${1:-}" ;;
    db-add-account) cmd_db_add_account "$@" ;;
    roster) cmd_roster "$@" ;;
    new-resident) cmd_new_resident "$@" ;;
    birth) cmd_birth "$@" ;;
    plan) cmd_plan "$@" ;;
    gift) cmd_gift "$@" ;;
    up) cmd_up ;;
    down) cmd_down ;;
    report) cmd_report ;;
    resources) cmd_resources ;;                     # ops: ORG-047
    chronicle) load_env; ( cd "$(profile_root)/brain" && python3 -m live_brain.chronicle --lab-root "$LAB_ROOT" \
                 --bots $(lab_bots) ${1:+--day "$1"} ) ;;
    dashboard) load_env; ( cd "$(profile_root)/brain" && python3 -m live_brain.dashboard --lab-root "$LAB_ROOT" \
                 --bots $(lab_bots) ${1:+--day "$1"} ) ;;   # dashboard: ORG-090, печатает путь к файлу
    episode) load_env; ( cd "$(profile_root)/brain" && python3 -m live_brain.episode "$@" --env "$LAB_ENV" \
                 --lab-root "$LAB_ROOT" --bots $(lab_bots) ) ;;   # serial: ORG-091 серия недели (только чтение)
    memoir) load_env; [[ "${1:-}" =~ ^bot[0-9]+$ ]] || die "scripts/lab memoir botNN [НЕДЕЛЯ] [--llm]"   # dreams: ORG-082
            bot="$1"; shift; ( cd "$(profile_root)/brain" && python3 -m live_brain.memoir "$@" --env "$LAB_ENV" \
                 --lab-root "$LAB_ROOT" --bot "$bot" ) ;;   # dreams: мемуары (только чтение памяти)
    modules) cmd_modules "$@" ;;                     # rollout: docs/ROLLOUT.md
    census) load_env; ( cd "$(profile_root)/brain" && python3 -m live_brain.census --repo "$(profile_root)" \
              --lab-root "$LAB_ROOT" --bots $(lab_bots) --max-online "${LAB_MAX_ONLINE:-}" "$@" ) ;;   # census: ORG-088
    alerts) load_env; if [[ -s "$LAB_ROOT/run/alerts.log" ]]; then tail -n "${1:-30}" "$LAB_ROOT/run/alerts.log"; else info "оповещений нет"; fi ;;
    organic) load_env; ( cd "$(profile_root)/brain" && python3 -m live_brain.organic "$@" \
               --lab-root "$LAB_ROOT" --bots $(lab_bots) ) ;;   # organic: ORG-113/114 метрики v2 и детектор машинности
    supervise) cmd_supervise ;;
    routine)
      case "${2:-}" in
        rest|hunt) cmd_plan "$1" "$2" ;;
        show) load_env; ( cd "$(profile_root)/brain" && python3 -m live_brain --env "$LAB_ENV" --bot "$1" --lab-root "$LAB_ROOT" --routine ) ;;
        *) die "scripts/lab routine botNN rest|hunt|show" ;;
      esac ;;
    build|deploy|activate|rollback)
      if [[ -f "$LAB_ENV" ]]; then load_env; fi
      require_release_mode "$sub"
      case "$sub" in
        build) cmd_build "$@" ;; deploy) cmd_deploy "$@" ;;
        activate) cmd_activate "$@" ;; rollback) cmd_rollback ;;
      esac ;;
    db-init)   load_env; require_release_mode db-init; cmd_db_init ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
