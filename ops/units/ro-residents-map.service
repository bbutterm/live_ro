[Unit]
Description=Ragnarok residents isolated map server
After=mariadb.service
After=ro-residents-char.service

[Service]
Type=simple
User=ro-residents
Group=ro-residents
WorkingDirectory=/root/ragnarok/repos/rathena
ExecStart=/root/ragnarok/repos/rathena/map-server
Restart=no
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/ragnarok/repos/rathena/log
InaccessiblePaths=/root/.hermes
CapabilityBoundingSet=
MemoryMax=900M
TasksMax=64
StandardOutput=append:/root/ragnarok/logs/map-server.log
StandardError=append:/root/ragnarok/logs/map-server.log
TimeoutStopSec=30
