# Скопируй в .env (cp .env.example .env) и вставь токен. Файл .env в git не попадает.
RO_WORLD_LLM_API_KEY=

# Всё ниже необязательно. По умолчанию: OpenRouter + DeepSeek V3.2, лимит из config/world.yaml.
# RO_WORLD_LLM_BASE_URL=https://openrouter.ai/api/v1
# RO_WORLD_LLM_MODEL=deepseek/deepseek-v3.2
# RO_WORLD_LLM_DAILY_USD=2
# Цена за 1M токенов — только если провайдер сам не сообщает стоимость ответа:
# RO_WORLD_LLM_PRICE_IN=1.0
# RO_WORLD_LLM_PRICE_OUT=3.0
