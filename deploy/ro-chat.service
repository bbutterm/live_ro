[Unit]
Description=RO resident chat independent of brain lifecycle
After=ro-world.service
Wants=ro-world.service
PartOf=ro-world.service
# Never give up: `ro stop/start` and short outages must not leave the chat failed.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/root/ragnarok/repos/live_ro
ExecStart=/opt/ro-residents/world-venv/bin/python -m packages.resident_world.chat
Restart=always
RestartSec=1
TimeoutStopSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
