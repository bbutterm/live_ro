# Пример локальных секретов лаборатории live_ro.
# `scripts/lab prepare` копирует его в $LAB_ROOT/secrets/lab.env (права 600).
# Заполняйте ТОЛЬКО копию. Сам lab.env никогда не коммитить.
# Формат: KEY=VALUE, без кавычек и без подстановок; '#' в начале строки — комментарий.
# Значение CHANGE_ME считается незаполненным: команды откажутся работать.

# MariaDB (база и пользователь создаются администратором, см. docs/SETUP.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ragnarok
DB_USER=ragnarok
DB_PASS=CHANGE_ME

# Учётка inter-server (char/map -> login). Заменяет upstream s1/p1.
INTER_USER=CHANGE_ME
INTER_PASS=CHANGE_ME

# Сеть. На этапах 1-2 только локально.
BIND_IP=127.0.0.1
PUBLIC_IP=127.0.0.1
SERVER_NAME=RO Bot Lab

# Игровой аккаунт бота bot01 (создаётся `scripts/lab db-init`).
BOT01_USER=CHANGE_ME
BOT01_PASS=CHANGE_ME
BOT01_SEX=M

# Сборка и логи
MAKE_JOBS=1
LOG_MAX_MB=50
