# Пример локальных секретов live_ro.
# `scripts/lab prepare` копирует его в $LAB_ROOT/secrets/live_ro.env (права 600),
# если такого файла ещё нет. Заполняйте ТОЛЬКО копию; её никогда не коммитить.
# Формат: KEY=VALUE, без кавычек и подстановок; '#' в начале строки — комментарий.
# Значение CHANGE_ME или пустое считается незаполненным.

# ---- Режим existing: уже работающая лаборатория оператора ----
# Если задан RATHENA_DIR, scripts/lab управляет этим собранным rAthena,
# НЕ рендерит его conf/import и запрещает deploy/activate/db-init.
# Каталог — тот, где лежат login-server/char-server/map-server и conf/.
RATHENA_DIR=
# Каталог OpenKore с собранным src/auto/XSTools/XSTools.so.
OPENKORE_DIR=
# 0 = не трогать conf/import рабочего rAthena (по умолчанию в режиме existing).
RENDER_SERVER_CONF=
# Готовый control-каталог бота. Если задан, профиль и fallback из Git НЕ применяются.
# Оставьте пустым, чтобы использовать bots/bot01 из Git + BOT01_USER/PASS ниже.
BOT01_CONTROL_DIR=

# ---- MariaDB ----
# В режиме existing можно оставить DB_PASS пустым: реквизиты читаются из
# $RATHENA_DIR/conf/import/inter_conf.txt (char_server_*, log_db_db).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ragnarok
LOG_DB_NAME=ragnarok_log
DB_USER=ragnarok
DB_PASS=CHANGE_ME

# ---- Учётки rAthena: каждое значение 1-23 печатных ASCII-символа без пробелов ----
# inter-server (char/map -> login), заменяет upstream s1/p1. Нужно для шаблонов
# и db-init (режим release).
INTER_USER=CHANGE_ME
INTER_PASS=CHANGE_ME
# Игровой аккаунт bot01 (подставляется в runtime-копию config.txt).
BOT01_USER=CHANGE_ME
BOT01_PASS=CHANGE_ME
BOT01_SEX=M
# Слот персонажа (необязательно; по умолчанию из профиля, `char 0`).
BOT01_CHAR_SLOT=

# ---- Сеть (этапы 1-2: только локально) ----
BIND_IP=127.0.0.1
PUBLIC_IP=127.0.0.1
SERVER_NAME=RO Bot Lab

# ---- Мозг bot01 (brain/live_brain), OpenRouter ----
# Ключ кладётся ТОЛЬКО сюда, в копию на VPS (права 600). Не в чат, не в Git.
# Платные вызовы выключены, пока явно не задано BRAIN_LLM=openrouter (после согласования
# модели и бюджета). При off или без ключа мозг работает на правилах, бот играет по профилю.
BRAIN_LLM=off
OPENROUTER_API_KEY=
# Точное имя модели — из каталога openrouter.ai/models.
OPENROUTER_MODEL=deepseek/deepseek-chat
# Не больше N запросов к модели за 24 ч (жёсткий лимит; дополнительно поставьте лимит в OpenRouter).
BRAIN_DAILY_LIMIT=300
# Плановое размышление раз в N секунд; события (смерть, уровень) не чаще BRAIN_EVENT_MIN_GAP;
# ответы в чат не чаще BRAIN_CHAT_MIN_GAP.
BRAIN_DECIDE_INTERVAL=300
BRAIN_EVENT_MIN_GAP=60
BRAIN_CHAT_MIN_GAP=15
# Таймаут запроса, с; максимум токенов ответа.
BRAIN_TIMEOUT=30
BRAIN_MAX_TOKENS=500

# ---- Прочее ----
# Запуск бота: tmux (по умолчанию, если установлен) или background.
BOT_RUNNER=tmux
MAKE_JOBS=1
LOG_MAX_MB=50
